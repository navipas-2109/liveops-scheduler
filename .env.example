# Copy this file to ".env" and fill in real values. Never commit ".env".

# Any PostgreSQL database. Recommended: Neon (free tier never needs a manual
# restore — it wakes on the first request). On Vercel, add it from the
# project's Storage tab; it sets DATABASE_URL and DATABASE_URL_UNPOOLED, and the
# build uses the unpooled one for migrations. Locally, set both below.
# DATABASE_URL = pooled connection string (used by the app)
# DIRECT_URL   = direct (unpooled) connection string (used for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Long random string used to sign login sessions.
# Generate one with: openssl rand -base64 32
JWT_SECRET=""

# Password given to the starter accounts created by the seed script.
SEED_USER_PASSWORD=""

# Optional, local only: months for `npm run db:seed-demo` to fill with sample
# slots, e.g. "2026-10,2026-11". Deploys no longer add sample slots.
SEED_DEMO_MONTHS=""
# Set to 1 to reload those months from scratch (deletes every slot in them).
SEED_DEMO_RESET=""

# Lark incoming-webhook URLs (https://open.larksuite.com/open-apis/bot/v2/hook/...)
LARK_WEBHOOK_PLANNER=""
LARK_WEBHOOK_OPERATION=""
LARK_WEBHOOK_FINANCE=""
