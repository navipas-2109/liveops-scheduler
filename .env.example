# Copy this file to ".env" and fill in real values. Never commit ".env".

# Supabase: click "Connect" at the top of the project.
# DATABASE_URL = "Transaction pooler" string (port 6543), with
#   ?pgbouncer=true&connection_limit=1 added at the end.
# DIRECT_URL = "Session pooler" string (port 5432), used for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Long random string used to sign login sessions.
# Generate one with: openssl rand -base64 32
JWT_SECRET=""

# Password given to the starter accounts created by the seed script.
SEED_USER_PASSWORD=""

# Optional: months to fill with sample slots for trying the app out,
# e.g. "2026-10,2026-11". Months that already have slots are left alone.
# Leave empty for real use.
SEED_DEMO_MONTHS=""
# Set to 1 for one deploy to reload those months from scratch (deletes every
# slot in them). Trial databases only.
SEED_DEMO_RESET=""

# Lark incoming-webhook URLs (https://open.larksuite.com/open-apis/bot/v2/hook/...)
LARK_WEBHOOK_PLANNER=""
LARK_WEBHOOK_OPERATION=""
LARK_WEBHOOK_FINANCE=""
