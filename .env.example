# Copy this file to ".env" and fill in real values. Never commit ".env".

# Supabase: Project Settings > Database > Connection string.
# DATABASE_URL uses the pooled connection (port 6543, add ?pgbouncer=true),
# DIRECT_URL uses the direct connection (port 5432) for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Long random string used to sign login sessions.
# Generate one with: openssl rand -base64 32
JWT_SECRET=""

# Password given to the starter accounts created by the seed script.
SEED_USER_PASSWORD=""

# Lark incoming-webhook URLs (https://open.larksuite.com/open-apis/bot/v2/hook/...)
LARK_WEBHOOK_PLANNER=""
LARK_WEBHOOK_OPERATION=""
LARK_WEBHOOK_FINANCE=""
